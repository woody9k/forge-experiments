{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metricforge.dev/schemas/matter-configuration.schema.json",
  "title": "Matter Forge configuration (genome)",
  "type": "object",
  "required": ["name", "version", "coordinate_system"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "description": { "type": "string", "maxLength": 4000 },
    "coordinate_system": {
      "type": "object",
      "required": ["type", "units"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["cartesian"] },
        "units": { "enum": ["SI"] }
      }
    },
    "components": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["id", "shape", "material"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "shape": { "$ref": "#/$defs/shape" },
          "material": { "$ref": "#/$defs/material" },
          "motion": { "$ref": "#/$defs/motion" },
          "mechanical_state": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "pressure_model": { "enum": ["none", "calculated"] },
              "stress_limit_model": { "enum": ["material_database"] },
              "safety_factor": { "type": "number", "minimum": 1.0, "maximum": 100 }
            }
          },
          "position": { "$ref": "#/$defs/vec3" },
          "orientation_axis": { "$ref": "#/$defs/vec3" }
        }
      }
    },
    "electromagnetic_systems": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": true,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type": { "enum": ["toroidal_coil", "solenoid", "parallel_plates_charged"] }
        },
        "$comment": "Schema reserved; the v0.2.0 compiler rejects EM systems with explicit 'unsupported'."
      }
    },
    "quantum_boundaries": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["id", "type", "plate_count", "plate_area_m2", "separation_m"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type": { "enum": ["parallel_plate_array"] },
          "plate_count": { "type": "integer", "minimum": 2, "maximum": 100000 },
          "plate_area_m2": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
          "separation_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "plate_thickness_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
          "material_model": { "enum": ["ideal_conductor"] },
          "plate_material_id": { "type": "string" },
          "temperature_k": { "type": "number", "minimum": 0, "maximum": 10000 },
          "placement": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "topology": { "enum": ["single_stack", "radial_array"] },
              "center": { "$ref": "#/$defs/vec3" },
              "radius_m": { "type": "number", "minimum": 0 }
            }
          }
        }
      }
    },
    "observation_regions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["id", "type"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "type": { "enum": ["point", "sphere"] },
          "position": { "$ref": "#/$defs/vec3" },
          "center": { "$ref": "#/$defs/vec3" },
          "radius_m": { "type": "number", "exclusiveMinimum": 0 }
        }
      }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_total_mass_kg": { "type": "number", "exclusiveMinimum": 0 },
        "maximum_stored_energy_j": { "type": "number", "exclusiveMinimum": 0 },
        "maximum_power_w": { "type": "number", "exclusiveMinimum": 0 },
        "maximum_magnetic_field_t": { "type": "number", "exclusiveMinimum": 0 },
        "maximum_component_speed_fraction_c": {
          "type": "number", "exclusiveMinimum": 0, "maximum": 0.999
        },
        "minimum_material_safety_factor": { "type": "number", "minimum": 1 },
        "require_buildable_materials": { "type": "boolean" }
      }
    },
    "parent_ids": {
      "type": "array", "items": { "type": "string" }, "maxItems": 8
    },
    "research_mode_negative_density": {
      "type": "boolean",
      "$comment": "Explicit opt-in required before any negative rest-mass density is accepted; off by default."
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
    "vec3": {
      "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
    },
    "shape": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["sphere", "spherical_shell", "torus", "box", "cylinder"] },
        "radius_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "outer_radius_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "thickness_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "major_radius_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "minor_radius_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
        "size_m": { "$ref": "#/$defs/vec3" },
        "length_m": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 }
      }
    },
    "material": {
      "type": "object",
      "required": ["model"],
      "additionalProperties": false,
      "properties": {
        "model": { "enum": ["homogeneous", "graded"] },
        "material_id": { "type": "string" },
        "base_material_id": { "type": "string" },
        "density_kg_m3": { "type": "number", "exclusiveMinimum": 0 },
        "density_profile": {
          "type": "string", "maxLength": 2000,
          "$comment": "Restricted expression in r_normalized and declared profile parameters; parsed by forge_metrics.parser."
        },
        "profile_parameters": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": { "type": "number" }
        }
      }
    },
    "motion": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "enum": ["none", "rotation"] },
        "axis": { "$ref": "#/$defs/vec3" },
        "angular_velocity_rad_s": { "type": "number" }
      }
    }
  }
}
