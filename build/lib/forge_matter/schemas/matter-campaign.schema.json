{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://metricforge.dev/schemas/matter-campaign.schema.json",
  "title": "Matter Forge search campaign",
  "$comment": "Campaigns can be created and validated in v0.2.0; execution is gated on backlog items B-2, B-5, B-7, B-13, B-18 (see docs/matter-forge-design.md §9).",
  "type": "object",
  "required": ["name", "objective", "constraints", "search"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_-]{1,63}$" },
    "description": { "type": "string", "maxLength": 4000 },
    "physical_question": { "type": "string", "maxLength": 2000 },
    "objective": {
      "type": "object",
      "required": ["primary"],
      "additionalProperties": false,
      "properties": {
        "primary": { "$ref": "#/$defs/objective" },
        "secondary": {
          "type": "array", "maxItems": 8,
          "items": { "$ref": "#/$defs/objective" }
        }
      }
    },
    "allowed_components": {
      "type": "array", "maxItems": 32,
      "items": { "type": "string" }
    },
    "constraints": {
      "type": "object",
      "additionalProperties": { "type": ["number", "boolean"] },
      "maxProperties": 32,
      "$comment": "Hard constraints; evaluated outside the scoring path and not mutable by any search operator."
    },
    "mutable_parameters": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object",
        "required": ["path"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "maxLength": 200 },
          "minimum": { "type": "number" },
          "maximum": { "type": "number" }
        }
      }
    },
    "solver_funnel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_gate": { "type": "integer", "minimum": 2, "maximum": 5 },
        "promotion_thresholds": { "type": "object", "additionalProperties": { "type": "number" } }
      }
    },
    "search": {
      "type": "object",
      "required": ["strategy", "random_seed"],
      "additionalProperties": false,
      "properties": {
        "strategy": {
          "enum": ["grid", "random", "bayesian", "evolutionary",
                   "multi_objective_evolutionary", "novelty"]
        },
        "population_size": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "generations": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "novelty_weight": { "type": "number", "minimum": 0, "maximum": 1 },
        "random_seed": { "type": "integer" }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maximum_candidate_evaluations": { "type": "integer", "minimum": 1 },
        "maximum_wall_clock_s": { "type": "number", "minimum": 1 }
      }
    },
    "scoring_function_version": { "type": "string" }
  },
  "$defs": {
    "objective": {
      "type": "object",
      "required": ["metric", "direction"],
      "additionalProperties": false,
      "properties": {
        "metric": { "type": "string", "maxLength": 100 },
        "direction": { "enum": ["maximize", "minimize"] },
        "observation_region": { "type": "string" }
      }
    }
  }
}
